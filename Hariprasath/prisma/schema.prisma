// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TokenStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  password        String
  name            String
  role            Role          @default(CUSTOMER)
  organization    Organization? @relation(fields: [organizationId], references: [id])
  organizationId  String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  branchId        String?
  appointments    Appointment[]
  tokens          Token[]
  notifications   Notification[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  refreshToken    String?
}

model Organization {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  branches    Branch[]
  services    Service[]
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Branch {
  id              String        @id @default(uuid())
  name            String
  address         String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  organizationId  String
  users           User[]
  services        BranchService[]
  queues          Queue[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Service {
  id              String          @id @default(uuid())
  name            String
  description     String?
  organization    Organization    @relation(fields: [organizationId], references: [id])
  organizationId  String
  branches        BranchService[]
  queues          Queue[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model BranchService {
  id          String   @id @default(uuid())
  branch      Branch   @relation(fields: [branchId], references: [id])
  branchId    String
  service     Service  @relation(fields: [serviceId], references: [id])
  serviceId   String
  isActive    Boolean  @default(true)
  @@unique([branchId, serviceId])
}

model Queue {
  id              String        @id @default(uuid())
  name            String
  branch          Branch        @relation(fields: [branchId], references: [id])
  branchId        String
  service         Service       @relation(fields: [serviceId], references: [id])
  serviceId       String
  currentValue    Int           @default(0)
  prefix          String?
  tokens          Token[]
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  config          Json?         // Custom queue configuration
}

model Token {
  id              String      @id @default(uuid())
  number          Int
  displayId       String      // e.g. "A101"
  status          TokenStatus @default(WAITING)
  priority        Int         @default(0)
  user            User?       @relation(fields: [userId], references: [id])
  userId          String?
  queue           Queue       @relation(fields: [queueId], references: [id])
  queueId         String
  estimatedTime   DateTime?
  calledAt        DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Appointment {
  id              String            @id @default(uuid())
  user            User              @relation(fields: [userId], references: [id])
  userId          String
  serviceId       String
  branchId        String
  scheduledAt     DateTime
  status          AppointmentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  title       String
  message     String
  isRead      Boolean  @default(false)
  type        String   // PUSH, SMS, EMAIL
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entity      String
  entityId    String
  userId      String
  payload     Json?
  createdAt   DateTime @default(now())
}
